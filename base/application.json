{
  "$schema": "https://raw.githubusercontent.com/neupgroup/neup.sites/main/schemas/application.json",
  "identity": {
    "name": "Happy Mountain Nepal",
    "@comment:name": "Application name used for identification.",
    "name:translation": {
      "en": "Happy Mountain Nepal",
      "ne": ""
    },
    "@comment:name:translation": "Application name's array translations for different languages.",
    "description": "Tourism and travel agency application for Happy Mountain Nepal.",
    "@comment:description": "Description for the application owner.",
    "version": "1.0.0.00",
    "@comment:version": "Published application version. The final counter tracks updates.",
    "applicationId": "neupgroup",
    "@comment:applicationId": "Unique identifier for the application. Used for internal tracking and management."
  },
  "design": {
    "color": {
      "primary": {
        "50": "#F8FAFC",
        "100": "#F1F5F9",
        "200": "#E2E8F0",
        "300": "#CBD5E1",
        "400": "#94A3B8",
        "500": "#64748B",
        "600": "#475569",
        "700": "#334155",
        "800": "#1E293B",
        "900": "#0F172A",
        "950": "#020617",
        "1000": "#000000"
      },
      "@comment": "Add up to three color families: primary, secondary, and tertiary."
    },
    "spacing": {
      "small": "4px",
      "medium": "8px",
      "large": "16px",
      "extraLarge": "32px"
    },
    "cornering": {
      "small": "4px",
      "medium": "8px",
      "large": "16px",
      "extraLarge": "32px"
    },
    "elements": {
      "theme.dark": {
        "seperator": "#colors.primary.500",
        "button": {
          "background": "#colors.primary.500",
          "text": "#colors.primary.50"
        }
      },
      "theme.light": {
        "seperator": "#colors.primary.500",
        "button": {
          "background": "#colors.primary.500",
          "text": "#colors.primary.50"
        }
      },
      "theme.black": {
        "seperator": "#colors.primary.500",
        "button": {
          "background": "#colors.primary.500",
          "text": "#colors.primary.50"
        }
      }
    },
    "typography": {
      "fontFamily": {
        "primary": "Outfit, sans-serif",
        "secondary": "Arial, sans-serif"
      },
      "customStyles": {}
    }
  },
  "features": {
    "database": {
      "isRequired": true,
      "type": "sqlite"
    },
    "fileStorage": {
      "isRequired": true,
      "type": "neupcdn"
    }
  },
  "account": {
    "isRequired": false,
    "accountSystem": "neupId/emailpass/userpass"
  },
  "logica": {
    "requiredModules": [
      "analytics",
      "sites"
    ]
  },
  "permissions": [],
  "storage": {
    "type": "local",
    "driveRelocation": {
      "from": "",
      "@comment:from": "Base URL generated by the application.",
      "to": "",
      "@comment:to": "Replacement base path for rendered assets."
    }
  },
  "platforms": {
    "web": {
      "exists": true,
      "location": "https://happymountainnepal.com",
      "basepath": ""
    }
  },
  "assets": {
    "logo": {
      "main": "/assets/logo.png",
      "48x48": "/assets/android/icon-48.png",
      "72x72": "/assets/android/icon-72.png",
      "96x96": "/assets/android/icon-96.png",
      "144x144": "/assets/android/icon-144.png",
      "256x256": "/assets/android/icon-256.png",
      "512x512": "/assets/android/icon-512.png",
      "1024x1024": "/assets/android/icon-1024.png",
      "background": "/assets/android/background.png",
      "adaptive": {
        "foreground": "/assets/android/adaptive-foreground.png",
        "background": "/assets/android/adaptive-background.png"
      },
      "altText": "Happy Mountain Nepal Logo"
    },
    "favicon": {
      "path": "/assets/favicon.ico",
      "altText": "Happy Mountain Nepal Favicon"
    },
    "splashScreen": {
      "path": "/assets/splash.png",
      "altText": "Happy Mountain Nepal Splash Screen"
    }
  }
}
